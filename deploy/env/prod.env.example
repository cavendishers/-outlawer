ENVIRONMENT=production

POSTGRES_DB=outlawer
POSTGRES_USER=outlawer
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql+psycopg://outlawer:replace-with-a-url-encoded-password@postgres:5432/outlawer

REDIS_URL=redis://redis:6379/0
BROKER_URL=amqp://guest:guest@rabbitmq:5672//

MINIO_ROOT_USER=replace-with-a-minio-admin
MINIO_ROOT_PASSWORD=replace-with-a-strong-minio-password
MINIO_ACCESS_KEY=replace-with-a-minio-admin
MINIO_SECRET_KEY=replace-with-a-strong-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=outlawer-assets

SECRET_KEY=replace-with-at-least-32-random-characters
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
BOOTSTRAP_ADMIN_DISPLAY_NAME=Outlawer Admin

NEXT_PUBLIC_API_BASE_URL=/api/v1
